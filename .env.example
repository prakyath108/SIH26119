# Sovereign Platform Environment Variables
# Copy this file to .env and fill in your values

# ==========================================
# Database (PostgreSQL with pgvector)
# ==========================================
POSTGRES_PASSWORD=sovereign
DATABASE_URL=postgresql+asyncpg://sovereign:${POSTGRES_PASSWORD}@postgres:5432/sovereign

# ==========================================
# Redis Cache
# ==========================================
REDIS_URL=redis://redis:6379/0

# ==========================================
# MinIO / S3 Object Storage
# ==========================================
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=sovereign
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# ==========================================
# Authentication & Security
# ==========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-use-32-char-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# LLM / AI (vLLM or OpenAI-compatible)
# ==========================================
VLLM_BASE_URL=http://vllm:8001/v1
VLLM_API_KEY=vllm-local

# Optional: Use external LLM instead of vLLM
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-key

# ==========================================
# Application Settings
# ==========================================
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
VERSION=1.0.0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]

# ==========================================
# Observability (Optional)
# ==========================================
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
# LOG_LEVEL=INFO

# ==========================================
# Solver Workers
# ==========================================
WORKER_CONCURRENCY=2

# ==========================================
# Web Frontend
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1